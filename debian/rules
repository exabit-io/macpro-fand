#!/usr/bin/make -f
PKGDIR := debian/macpro-fand
MANSRC := $(wildcard man/*.scd)
MANPAGES := $(MANSRC:.scd=)

%:
	dh $@

.PHONY: check-version
check-version:
	@sv=$$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml); \
	 cv=$$(dpkg-parsechangelog -SVersion | sed -E 's/^[0-9]+://; s/-[^-]*$$//'); \
	 if [ "$$sv" != "$$cv" ]; then \
	   echo "Cargo.toml version $$sv differs from changelog $$cv" >&2; exit 1; \
	 fi

man/%: man/%.scd
	{ printf '%s\n' "'\\\" t"; scdoc < $<; } > $@

override_dh_auto_build: check-version $(MANPAGES)
	cargo build --locked --offline --release --bin macpro-fand

override_dh_auto_test:
	cargo test --locked --offline --all-targets
	cargo build --locked --offline --example oracle
	python3 tests/parity.py target/debug/examples/oracle
	python3 tests/cli.py target/release/macpro-fand

override_dh_auto_clean:
	rm -f $(MANPAGES)
	rm -rf target

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_installman:
	dh_installman $(MANPAGES)

override_dh_auto_install:
	install -D -m 0755 target/release/macpro-fand $(PKGDIR)/usr/sbin/macpro-fand
	install -D -m 0644 macpro-fand.conf $(PKGDIR)/etc/macpro-fand.conf
	install -D -m 0755 -t $(PKGDIR)/usr/lib/macpro-fand debian/scripts/fans-to-max debian/scripts/backup debian/scripts/t2fanrd-guard
	install -D -m 0644 debian/macpro-fand-backup.service $(PKGDIR)/usr/lib/systemd/system/macpro-fand-backup.service
	install -D -m 0644 debian/t2fanrd.service.d/macpro-fand-backup.conf $(PKGDIR)/usr/lib/systemd/system/t2fanrd.service.d/macpro-fand-backup.conf

# Only macpro-fand.service is enabled and started by the maintainer scripts. macpro-fand-backup.service runs
# only through OnFailure=: starting it on install would run the failure path (fans to full speed, t2fanrd).
override_dh_installsystemd:
	dh_installsystemd macpro-fand.service

override_dh_builddeb:
	dh_builddeb -- -Zxz
