# macpro-fand.service -- installed by the macpro-fand package.
#
# Zone fan control and the 1228 W power budget for a Mac Pro 7,1 (2019).
# Exactly one process may own the fans, and macpro-fand wins. t2fanrd is not
# required; when it is installed it is the backup governor:
#   - Starting this unit stops t2fanrd (ExecStartPre, which waits for it to
#     exit before the daemon takes the fans).
#   - t2fanrd cannot start while this unit is active, starting, or waiting to
#     restart (t2fanrd.service.d/macpro-fand-backup.conf, from this package).
#   - t2fanrd takes over when this unit stops cleanly (the stop hook hands the
#     fans over) or fails for good (OnFailure= starts macpro-fand-backup, which
#     sets every fan to full speed first, then starts t2fanrd if installed).
# Fail-safe: whenever neither governor runs, every fan is at full speed (this
# unit's failure path, macpro-fand-backup, and t2fanrd's stop hook). The fans
# are never put in the SMC's automatic mode.
# No Conflicts=t2fanrd.service: that dependency is symmetric, so starting
# t2fanrd would stop this unit (2.0.0 did, and lost the fans to its backup).
#
# Verify:  systemctl status macpro-fand
#          journalctl -u macpro-fand -o cat | tail -1

[Unit]
Description=Mac Pro 7,1 zone fan control and power budget
Documentation=man:macpro-fand(8) man:macpro-fand.conf(5)
OnFailure=macpro-fand-backup.service
After=resize-amdgpu-bars.service
# Never give up restarting: every failed run ends with the fans at their caps
# (ExecStopPost). Exit status 78 means no Mac Pro 7,1 fan hardware: no restart.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Blocking stop: the start waits until t2fanrd has fully exited (its stop hook
# included), so the fans never have two writers. Not an error if t2fanrd is absent.
ExecStartPre=-/usr/bin/systemctl stop t2fanrd.service
ExecStart=/usr/sbin/macpro-fand
ExecStopPost=/usr/sbin/macpro-fand --stopped
WatchdogSec=20
Restart=always
RestartSec=2
RestartPreventExitStatus=78
TimeoutStopSec=15
# The start waits up to 240 s for applesmc and then up to 240 s for the
# amdgpu dies (amdgpu binds late in boot when resize-amdgpu-bars loads it;
# applesmc-t2 is late after a kernel update while DKMS rebuilds it): 540 s
# covers both, so systemd does not kill a start that would have succeeded.
TimeoutStartSec=540
RuntimeDirectory=macpro-fand
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
